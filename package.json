{
  "name": "paper-notebook-light",
  "displayName": "Paper Notebook Light",
  "description": "A warm, paper-like light theme with ink-style colors.",
  "publisher": "kpab",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Themes"],
  "keywords": ["theme", "light", "paper", "sepia", "warm", "notebook", "ink"],
  "galleryBanner": {
    "color": "#EADFCC",
    "theme": "light"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kpab/vscode-paper-like-theme"
  },
  "scripts": {
    "package": "npx @vscode/vsce package",
    "install-extension": "code --install-extension \"paper-notebook-light-$npm_package_version.vsix\""
  },
  "contributes": {
    "themes": [
      {
        "label": "Paper Notebook Light",
        "uiTheme": "vs",
        "path": "./themes/paper-notebook-light-color-theme.json"
      }
    ]
  }
}
