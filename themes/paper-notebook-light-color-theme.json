  "tokenColors": [
    {
      "scope": ["keyword", "storage"],
      "settings": {
        "foreground": "#854D2C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#5C6E4E"
      }
    },
    {
      "scope": ["variable", "parameter"],
      "settings": {
        "foreground": "#3A2E23"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#A86434"
      }
    },
    {
      "scope": ["entity.name.function"],
      "settings": {
        "foreground": "#6C3F2C"
      }
    },
    {
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#4E5F73"
      }
    },
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#8A7D6D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["punctuation", "delimiter"],
      "settings": {
        "foreground": "#4A3C2E"
      }
    },
    {
      "scope": ["meta.diff.header"],
      "settings": {
        "foreground": "#6C3F2C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#3A6B3A"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#9A3A3A"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#854D2C"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#925F3C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["constant.language", "constant.character"],
      "settings": {
        "foreground": "#A86434",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["support.function"],
      "settings": {
        "foreground": "#6C3F2C"
      }
    },
    {
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#8A5A2B"
      }
    },
    {
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#A86434"
      }
    },
    {
      "scope": ["variable.other.property", "support.variable.property"],
      "settings": {
        "foreground": "#4A3C2E"
      }
    },
    {
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#6C3F2C"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#6C3F2C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#3A2E23",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#3A2E23",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#7A5136"
      }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#8A5A2B",
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#7D6A52",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#9A3A3A"
      }
    }
  ]
}
